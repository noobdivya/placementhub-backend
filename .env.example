# Copy to .env and adjust. Nothing here is a real secret.

APP_ENV=development                       # development | production
HTTP_ADDR=:8080
DATABASE_URL=postgres://placementhub:placementhub@localhost:5433/placementhub?sslmode=disable

# --- Auth (REQUIRED in production: at least 32 random bytes) ---
# generate one:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h                    # 14 days

# --- Browser / cookies ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma separated
COOKIE_SECURE=false                       # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                       # lax | strict | none (none needs COOKIE_SECURE=true)
TRUSTED_PROXY=false                       # true only behind a proxy that sets X-Forwarded-For

# --- First admin (created once, if no admin exists yet) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=                 # at least 10 characters
BOOTSTRAP_ADMIN_NAME=Placement Officer

# --- Web Push (browser notifications). Generate with:  go run ./cmd/vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:placements@yourcollege.edu

# --- Behaviour ---
APP_TIMEZONE=Asia/Kolkata                 # college timezone (deadlines end at midnight here)
OFFER_VALIDITY_DAYS=7
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
RUN_WORKERS=true                          # push worker + scheduler; set false on extra replicas if you prefer
